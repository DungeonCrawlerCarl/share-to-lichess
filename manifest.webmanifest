{"background_color":"#262421","description":"Share a chess puzzle photo from any app, scan the board on your device, and open the position on the Lichess analysis board. Free, no account, no upload, no scan limit.","display":"standalone","icons":[{"purpose":"any","sizes":"192x192","src":"./icons/icon-192.png","type":"image/png"},{"purpose":"any","sizes":"512x512","src":"./icons/icon-512.png","type":"image/png"}],"name":"Share to Lichess","scope":"./","share_target":{"action":"./share","enctype":"multipart/form-data","method":"POST","params":{"files":[{"name":"image","accept":["image/*","image/jpeg","image/png",".jpg",".jpeg",".png",".webp"]}],"text":"text","title":"title","url":"url"}},"short_name":"Lichess Share","start_url":"./","theme_color":"#262421"}